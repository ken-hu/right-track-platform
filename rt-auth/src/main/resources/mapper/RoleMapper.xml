<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pers.ken.rt.auth.repository.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="pers.ken.rt.auth.repository.po.Role">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
            <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,description,
        created_at,updated_at
    </sql>
    <insert id="insertRolePolicyRel">
        insert into role_policy_rel (role_id, policy_id)
        values (#{roleId}, #{policyId})
    </insert>
    <select id="selectByUser" resultType="pers.ken.rt.auth.repository.po.Role">
        select role.*
        from user_role_rel rel
                 join role
                      on rel.role_id = role.id
        where user_id = #{userId}
    </select>
</mapper>
